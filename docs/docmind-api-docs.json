    "/api/v1/models/{id}/debug": {
      "post": {
        "tags": ["模型管理"],
        "summary": "调试模型",
        "description": "测试模型调用，返回调试信息",
        "operationId": "debugModel",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": { "type": "string", "description": "测试输入" },
                  "documents": { "type": "string", "description": "测试文档列表JSON" },
                  "options": { "type": "string", "description": "调试选项JSON" },
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
