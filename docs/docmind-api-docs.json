            "description": "调试结果"
          }
        }
      }
    },
    "/api/v1/tenants": {
      "get": {
        "tags": ["空间管理"],
        "summary": "获取所有空间列表",
        "description": "获取所有可访问的工作空间",
        "operationId": "listAllTenants",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "获取成功"
          }
        }
      },
      "post": {
        "tags": ["空间管理"],
        "summary": "创建工作空间",
        "description": "创建新的工作空间",
        "operationId": "createTenant",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功"
          }
        }
      }
    },
    "/api/v1/tenants/{id}": {
      "put": {
        "tags": ["空间管理"],
        "summary": "更新工作空间",
