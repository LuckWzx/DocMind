{
  "openapi": "3.0.3",
  "info": {
    "title": "DocMind API 接口文档",
    "description": "DocMind 智能知识管理系统 API 接口文档，支持导入 Apifox",
    "version": "1.0.0",
    "contact": {
      "name": "DocMind Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3888",
      "description": "本地开发服务器"
    }
  ],
  "tags": [
    {
      "name": "认证管理",
      "description": "用户登录、注册、Token管理等认证相关接口"
    },
    {
      "name": "知识库管理",
      "description": "知识库的增删改查、文件上传、标签管理等"
    },
    {
      "name": "对话管理",
      "description": "会话管理、消息发送、流式对话等"
    },
    {
      "name": "智能体管理",
      "description": "智能体的创建、配置、IM渠道管理等"
    },
    {
      "name": "模型管理",
      "description": "模型的配置、测试、凭证管理等"
    },
    {
      "name": "空间管理",
      "description": "工作空间的创建、成员管理、API Key管理等"
    },
    {
      "name": "组织管理",
      "description": "组织的创建、成员管理、知识库共享等"
    },
    {
      "name": "Wiki管理",
      "description": "Wiki页面的创建、编辑、图谱查询等"
    },
    {
      "name": "数据源管理",
      "description": "数据源的配置、同步、日志查询等"
    },
    {
      "name": "系统管理",
      "description": "系统信息、解析引擎、存储引擎、系统设置等"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["认证管理"],
        "summary": "用户登录",
        "description": "使用邮箱和密码进行登录，返回用户信息和Token",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "admin@example.com",
                "password": "admin123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["认证管理"],
        "summary": "用户注册",
        "description": "新用户注册账号",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["认证管理"],
        "summary": "获取当前用户信息",
        "description": "获取当前登录用户的详细信息",
        "operationId": "getCurrentUser",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": { "$ref": "#/components/schemas/UserInfo" },
                        "tenant": { "$ref": "#/components/schemas/TenantInfo" },
                        "memberships": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/MembershipInfo" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["认证管理"],
        "summary": "用户登出",
        "description": "退出当前登录状态",
        "operationId": "logout",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "登出成功"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["认证管理"],
        "summary": "刷新Token",
        "description": "使用refresh_token获取新的access_token",
        "operationId": "refreshToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "刷新成功"
          }
        }
      }
    },
    "/api/v1/knowledge-bases": {
      "get": {
        "tags": ["知识库管理"],
        "summary": "获取知识库列表",
        "description": "获取当前空间的知识库列表",
        "operationId": "listKnowledgeBases",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "agent_id",
            "in": "query",
            "description": "按智能体ID筛选",
            "schema": { "type": "string" }
          },
          {
            "name": "creator",
            "in": "query",
            "description": "按创建者筛选：all=全部, mine=我的, others=他人",
            "schema": {
              "type": "string",
              "enum": ["all", "mine", "others"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/KnowledgeBase" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["知识库管理"],
        "summary": "创建知识库",
        "description": "创建一个新的知识库",
        "operationId": "createKnowledgeBase",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateKnowledgeBaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KnowledgeBase" }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge-bases/{id}": {
      "get": {
        "tags": ["知识库管理"],
        "summary": "获取知识库详情",
        "description": "获取指定知识库的详细信息",
        "operationId": "getKnowledgeBaseById",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/KnowledgeBase" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["知识库管理"],
        "summary": "更新知识库",
        "description": "更新指定知识库的信息",
        "operationId": "updateKnowledgeBase",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateKnowledgeBaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      },
      "delete": {
        "tags": ["知识库管理"],
        "summary": "删除知识库",
        "description": "删除指定的知识库",
        "operationId": "deleteKnowledgeBase",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/api/v1/knowledge-bases/{kbId}/knowledge/file": {
      "post": {
        "tags": ["知识库管理"],
        "summary": "上传知识文件",
        "description": "上传文件到指定知识库",
        "operationId": "uploadKnowledgeFile",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "kbId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "tag_ids": {
                    "type": "string",
                    "description": "标签ID列表，逗号分隔"
                  },
                  "process_config": {
                    "type": "string",
                    "description": "处理配置JSON字符串"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功"
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": ["对话管理"],
        "summary": "获取会话列表",
        "description": "获取当前用户的会话列表",
        "operationId": "getSessionsList",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "source",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功"
          }
        }
      },
      "post": {
        "tags": ["对话管理"],
        "summary": "创建会话",
        "description": "创建新的对话会话",
        "operationId": "createSession",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功"
          }
        }
      }
    },
    "/api/v1/sessions/{session_id}": {
      "put": {
        "tags": ["对话管理"],
        "summary": "更新会话",
        "description": "更新会话标题和描述",
        "operationId": "updateSession",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      },
      "delete": {
        "tags": ["对话管理"],
        "summary": "删除会话",
        "description": "删除指定会话",
        "operationId": "delSession",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/api/v1/knowledge-chat/{session_id}": {
      "post": {
        "tags": ["对话管理"],
        "summary": "知识库对话",
        "description": "基于知识库进行流式对话",
        "operationId": "knowledgeChat",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string", "description": "用户问题" }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "流式响应",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents": {
      "get": {
        "tags": ["智能体管理"],
        "summary": "获取智能体列表",
