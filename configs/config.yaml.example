# 应用配置
app:
  name: DocMind
  version: 1.0.0
  mode: debug  # debug, release, test
  port: 3888

# 数据库配置
database:
  postgresql:
    host: localhost
    port: 5432
    username: postgres
    password: postgres
    database: docmind
    max_idle_conns: 10
    max_open_conns: 100
    sslmode: disable
  redis:
    host: localhost
    port: 6379
    password: ""
    db: 0
    pool_size: 10

# JWT 配置
jwt:
  secret: your-secret-key-here
  expire_hours: 24

# 日志配置
log:
  level: info
  filename: logs/app.log
  max_size: 100
  max_backups: 7
  max_age: 30
  compress: false

# CORS 配置
cors:
  enabled: true
  allow_origins:
    - http://localhost:3000
    - http://localhost:5173
  allow_methods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  allow_headers:
    - Origin
    - Content-Type
    - Accept
    - Authorization
  expose_headers:
    - Content-Length
  allow_credentials: true
  max_age: 120

# DocReader 配置
docreader:
  addr: 127.0.0.1:50051

# 本地存储配置
storage:
  local_root: data/files

# MinIO 配置
minio:
  endpoint: ""          # MinIO 服务地址
  base_url: ""
  access_key_id: ""         # Access Key
  access_key_secret: ""     # Secret Key
  bucket_name: ""           # Bucket 名称
  path_prefix: "knowledge/images"      # 文档图片对象前缀
  use_ssl: false                      # 是否使用 SSL

# Neo4j 图数据库配置（长期记忆存储）
neo4j:
  enabled: false        # 开关：false 时整个长期记忆模块降级跳过（不阻塞主流程）
  uri: bolt://127.0.0.1:7687
  username: neo4j
  password: ""

# 长期记忆配置（跨会话记忆，依赖 neo4j.enabled）
memory:
  enabled: true         # 长期记忆总开关
  model_id: ""          # 提取/关键词模型 ID（空 = 由调用方传会话模型）
  retrieve_limit: 5     # 检索返回的最大 Episode 数
